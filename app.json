{
  "expo": {
    "name": "Karmyogi HomeTown Staff",
    "slug": "karmyogi-hometown-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "karmyogi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.hometown.karmyogi.staff",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "HomeTown Karmyogi uses your location to verify store attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HomeTown Karmyogi uses your location to verify store attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C8A24A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hometown.karmyogi.staff",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HomeTown Karmyogi uses your location to verify store attendance.",
          "locationAlwaysAndWhenInUsePermission": "HomeTown Karmyogi uses your location to verify store attendance.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B2416",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cecb6a7-1984-483b-b249-e558f5387898"
      }
    },
    "owner": "aashi910"
  }
}
