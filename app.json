{
  "expo": {
    "name": "Karmyogi HomeTown Staff",
    "slug": "karmyogi-hometown-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/appicon.png",
    "scheme": "karmyogi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./src/assets/images/appicon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.hometown.karmyogi.staff",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "HomeTown Karmyogi uses your location to verify store attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HomeTown Karmyogi uses your location to verify store attendance.",
        "NSLocationAlwaysUsageDescription": "HomeTown Karmyogi uses your location to automatically check you in and out of the store.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/appicon.png",
        "backgroundColor": "#C8A24A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hometown.karmyogi.staff",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/appicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HomeTown Karmyogi uses your location to verify store attendance.",
          "locationAlwaysAndWhenInUsePermission": "HomeTown Karmyogi uses your location to automatically check you in and out of the store.",
          "locationAlwaysPermission": "HomeTown Karmyogi uses your location in the background to automatically check you out when you leave the store.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B2416",
          "android": {
            "image": "./src/assets/images/appicon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62d2b788-c16f-41e5-a60e-26ea910e1b44"
      }
    }
  }
}